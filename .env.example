# ===========================================
# Arthings - Environment Configuration
# ===========================================
# Copy to .env and fill in real values. Never commit .env.

# --- Database ------------------------------------------------------------
# Neon Postgres connection string: https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Server --------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public origin. Used to build links inside outgoing emails, so it must match
# how users actually reach the site.
APP_URL=http://localhost:3000
APP_NAME=Arthings

# --- Session -------------------------------------------------------------
# REQUIRED in production; the server refuses to boot without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

SESSION_MAX_AGE_HOURS=168
SESSION_TABLE=user_sessions

# --- Email (SMTP) --------------------------------------------------------
# Works with Brevo, Amazon SES, SendGrid, Mailgun, Gmail, etc.
# When left blank in development, emails are printed to the console instead
# of being sent — verification codes stay readable while testing.
#
#   Brevo:    smtp-relay.brevo.com:587
#   SendGrid: smtp.sendgrid.net:587      (SMTP_USER=apikey)
#   SES:      email-smtp.<region>.amazonaws.com:587
#   Gmail:    smtp.gmail.com:587         (requires an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Arthings <no-reply@arthings.com.ua>"

# --- Verification codes --------------------------------------------------
VERIFICATION_CODE_LENGTH=6
VERIFICATION_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN=60
PASSWORD_RESET_TTL_MINUTES=60

# --- Geocoding (OpenStreetMap Nominatim) ---------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Nominatim's usage policy REQUIRES a genuine identifying User-Agent with
# real contact details. Requests without one get blocked.
NOMINATIM_USER_AGENT="Arthings/1.0 (rental marketplace; contact: you@example.com)"

# Policy caps clients at 1 request/second. Do not lower this.
NOMINATIM_MIN_INTERVAL_MS=1100
GEOCODE_CACHE_TTL_DAYS=180
GEOCODE_COUNTRY_CODES=ua

# --- File storage --------------------------------------------------------
# local = ./uploads directory (development, or a VM with a persistent disk)
# blob  = Vercel Blob (REQUIRED on Vercel — its filesystem is ephemeral,
#         so anything written to disk disappears between invocations)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_MB=5
MAX_FILES_PER_LISTING=10

# --- Security ------------------------------------------------------------
# Number of proxy hops in front of the app. Rate limiting keys on the client
# IP, so an incorrect value either lumps every visitor together or lets a
# spoofed header bypass the limits. Vercel/ngrok = 1.
TRUST_PROXY_HOPS=1

RATE_LIMIT_AUTH_WINDOW=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW=15
RATE_LIMIT_API_MAX=600
RATE_LIMIT_WRITE_WINDOW=60
RATE_LIMIT_WRITE_MAX=100

# --- Admin ---------------------------------------------------------------
# Email of the account promoted by `node prisma/promote-admin.js`
ADMIN_EMAIL=your-email@example.com
